# Copy to .env and fill in real values. .env is git-ignored.

# Postgres (used by docker-compose.yml for the db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskmanager

# Backend
# Local run:  postgresql://postgres:change-me@localhost:5432/taskmanager
# Docker:     docker-compose.yml builds this from the POSTGRES_* values above
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/taskmanager

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
